generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  EXPERT
  ADMIN
}

enum Status {
  DRAFT
  PENDING
  IN_REVIEW
  APPROVED
  REJECTED
}

enum AcademicLevel {
  ELEMENTARY
  MIDDLE_SCHOOL
  HIGH_SCHOOL
  COLLEGE
  GRADUATE
  PROFESSIONAL
}

enum BookSource {
  GUTENBERG
  OPEN_LIBRARY
  ARCHIVE_ORG
}

enum CacheStatus {
  NOT_CACHED
  CACHING
  CACHED
  STALE
}

model User {
  id             String       @id @default(uuid())
  email          String       @unique
  passwordHash   String
  name           String
  schoolName     String?
  role           Role         @default(USER)
  isVerified     Boolean      @default(false)
  submissions    Submission[]
  roomMemberships RoomMember[]
  messages       Message[]
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  createdAt      DateTime     @default(now())
  callParticipations CallParticipant[]
  reportsFiled   Report[]
  blocking       UserBlock[]  @relation("UserBlocking")
  blockedBy      UserBlock[]  @relation("UserBlocked")
  pushToken      String?
  notifications  Notification[]
}

model Submission {
  id            String        @id @default(uuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id])
  title         String
  description   String
  fileUrl       String
  academicLevel AcademicLevel
  status        Status        @default(DRAFT)
  license       String
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model Book {
  id            String        @id @default(uuid())
  source        BookSource
  sourceId      String
  title         String
  author        String
  description   String
  coverUrl      String?
  license       String
  academicLevel AcademicLevel
  subjectTags   String[]
  originUrl     String?
  cachedFileUrl String?
  cacheStatus   CacheStatus   @default(NOT_CACHED)
  lastFetchedAt DateTime?
  createdAt     DateTime      @default(now())

  @@unique([source, sourceId])
}

enum RoomType {
  DIRECT
  GROUP
  TOPIC
}

model Room {
  id            String         @id @default(uuid())
  type          RoomType
  name          String?        
  topic         String?        
  isPublic      Boolean        @default(false)
  createdAt     DateTime       @default(now())
  members       RoomMember[]
  messages      Message[]
  whiteboard    WhiteboardSession?
  calls         CallSession[]
}

model RoomMember {
  id        String   @id @default(uuid())
  roomId    String
  room      Room     @relation(fields: [roomId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  joinedAt  DateTime @default(now())
  isAdmin   Boolean  @default(false)

  @@unique([roomId, userId])
}

model Message {
  id            String    @id @default(uuid())
  roomId        String
  room          Room      @relation(fields: [roomId], references: [id])
  senderId      String
  sender        User      @relation(fields: [senderId], references: [id])
  content       String
  attachmentUrl String?
  replyToId     String?
  createdAt     DateTime  @default(now())
  editedAt      DateTime?
}

model WhiteboardSession {
  id          String   @id @default(uuid())
  roomId      String   @unique
  room        Room     @relation(fields: [roomId], references: [id])
  snapshotUrl String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum CallStatus {
  ONGOING
  ENDED
}

model CallSession {
  id           String            @id @default(uuid())
  roomId       String
  room         Room              @relation(fields: [roomId], references: [id])
  status       CallStatus        @default(ONGOING)
  startedAt    DateTime          @default(now())
  endedAt      DateTime?
  participants CallParticipant[]
}

model CallParticipant {
  id        String      @id @default(uuid())
  callId    String
  call      CallSession @relation(fields: [callId], references: [id])
  userId    String
  user      User        @relation(fields: [userId], references: [id])
  joinedAt  DateTime    @default(now())
  leftAt    DateTime?

  @@unique([callId, userId])
}

enum ReportStatus {
  PENDING
  REVIEWED
  RESOLVED
}

model Report {
  id          String       @id @default(uuid())
  targetType  String       // 'ROOM', 'MESSAGE', 'USER'
  targetId    String
  reporterId  String
  reporter    User         @relation(fields: [reporterId], references: [id])
  reason      String
  status      ReportStatus @default(PENDING)
  createdAt   DateTime     @default(now())
}

model UserBlock {
  id          String   @id @default(uuid())
  blockerId   String
  blocker     User     @relation("UserBlocking", fields: [blockerId], references: [id])
  blockedId   String
  blocked     User     @relation("UserBlocked", fields: [blockedId], references: [id])
  createdAt   DateTime @default(now())

  @@unique([blockerId, blockedId])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  title     String
  body      String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

enum PlanTier {
  FREE
  PRO
  ENTERPRISE
}

enum SubscriptionStatus {
  ACTIVE
  INACTIVE
  PAST_DUE
  CANCELED
}

model Organization {
  id           String        @id @default(uuid())
  name         String
  domain       String?       @unique
  planTier     PlanTier      @default(FREE)
  users        User[]
  subscription Subscription?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Subscription {
  id               String             @id @default(uuid())
  organizationId   String             @unique
  organization     Organization       @relation(fields: [organizationId], references: [id])
  status           SubscriptionStatus @default(INACTIVE)
  provider         String             // 'paystack' or 'flutterwave'
  providerRef      String             @unique
  currentPeriodEnd DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
}
