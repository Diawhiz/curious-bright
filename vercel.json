{
  "version": 2,
  "outputDirectory": "staticfiles",
  "functions": {
    "curiousbright/wsgi.py": {
      "runtime": "python3.12",
      "maxDuration": 10
    }
  },
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "/static/$1"
    },
    {
      "src": "/(.*)",
      "dest": "curiousbright/wsgi.py"
    }
  ]
}
