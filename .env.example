# Database
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/curious_bright?schema=public

# JWT
JWT_SECRET=your-jwt-secret-here

# Server
PORT=4000
NODE_ENV=development

# Storage (S3 / Prisma Storage)
S3_ENDPOINT=https://t3.storage.dev
S3_ACCESS_KEY_ID=your-s3-access-key-id
S3_SECRET_ACCESS_KEY=your-s3-secret-access-key
S3_BUCKET=your-s3-bucket-name

# Paystack
PAYSTACK_SECRET_KEY=sk_live_your-paystack-secret-key-here
PAYSTACK_PUBLIC_KEY=pk_live_your-paystack-public-key-here
